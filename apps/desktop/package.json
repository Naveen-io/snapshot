{
  "name": "@orbit/desktop",
  "version": "0.1.0",
  "description": "FROSTEX ORBIT Desktop Shell and HUD Window",
  "main": "./dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "build:electron": "node ../../node_modules/esbuild/bin/esbuild src/main/main.ts --bundle --platform=node --target=node22 --outfile=dist-electron/main.cjs --external:electron && node ../../node_modules/esbuild/bin/esbuild src/preload/preload.ts --bundle --platform=node --target=node22 --outfile=dist-electron/preload.cjs --external:electron",
    "build:renderer": "node ../../node_modules/vite/bin/vite.js build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "npx electron dist-electron/main.cjs",
    "test": "node --experimental-strip-types --test src/main/__tests__/*.test.ts"
  },
  "author": "FROSTEX Engineering",
  "build": {
    "appId": "com.frostex.orbit",
    "productName": "FROSTEX ORBIT",
    "electronVersion": "35.7.5",
    "npmRebuild": false,
    "directories": {
      "output": "dist-package"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "dir"
    }
  },
  "dependencies": {
    "@orbit/protocol": "*",
    "app-builder-bin": "^5.0.0-alpha.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
